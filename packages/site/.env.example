# SHA-256-Hash des gemeinsamen Seiten-Passworts (siehe SPEC.md Abschnitt 6).
# Erzeugen z.B. mit:
#   node -e "console.log(require('crypto').createHash('sha256').update('DEIN-PASSWORT').digest('hex'))"
# Lokale Entwicklung: .env (gitignored) mit einem eigenen Dev-Passwort anlegen.
VITE_SITE_PASSWORD_HASH=

# URL des deployten Cloudflare Workers (packages/worker), z.B.
# https://tacto-upload.<dein-cloudflare-subdomain>.workers.dev
VITE_WORKER_URL=
